  m_Script: {fileID: 11500000, guid: 2adeaea8873edd14d94a7b12c458d418, type: 3}
  m_Name: "\uC57D\uBC29"
  m_EditorClassIdentifier: Assembly-CSharp::PubDialogSO
  type: 4
  title_txt: "\uAE30\uAD34\uD55C \uC57D\uD0D5\uAE30\uC640 \uC815\uCCB4\uBD88\uBA85\uC758
    \uD574\uACE8 \uD56D\uC544\uB9AC \uC5B4\uB450\uC6B4 \uC57D\uBC29."
  content_txt: "\uAD34\uC0C1\uD55C \uB178\uC778\uC774 \uD284 \uD53C\uB97C \uB2E6\uC73C\uBA70
    \uBBF8\uC18C\uB97C \uC9C0\uC5B4 \uBCF4\uC785\uB2C8\uB2E4. \"\uBD80\uC791\uC6A9\uC774\uC57C
    \uC880 \uC788\uACA0\uC9C0\uB9CC... \uB2F9\uC7A5 \uCC9C\uB9C8\uB97C \uC7A1\uC73C\uB824\uBA74
    \uC774 \uC815\uB3C4\uB294 \uBC84\uD168\uC57C\uC9C0?\""
  entries:
  - content: "\uB3C5\uD608\uC744 \uC815\uC81C\uD574 \uB9CC\uB4E0 \uADF9\uC57D\uC785\uB2C8\uB2E4.
      \uC21C\uAC04\uC801\uC73C\uB85C \uAE30\uD608\uC744 \uB4A4\uD2C0\uC5B4 \uD30C\uAD34\uB825\uC744
      \uADF9\uB300\uD654\uD558\uC9C0\uB9CC, \uC2EC\uB9E5\uC774 \uD0C0\uB4E4\uC5B4
      \uAC11\uB2C8\uB2E4."
    desc: "\uC601\uAD6C ATK +1, \uCD5C\uB300 HP - 2"
    effects: 0500000007000000
  - content: "\uBF08\uB97C \uD1B5\uC9F8\uB85C \uAD73\uD600 \uAE08\uAC15\uBD88\uAD34\uC758
      \uC721\uC2E0\uC744 \uB9CC\uB4E4\uC5B4\uB0B4\uB294 \uACE0\uC57D\uC785\uB2C8\uB2E4.
      \uB2E4\uB9CC \uBAB8\uC774 \uBB34\uAC70\uC6CC\uC838 \uCD08\uC2DD\uC774 \uB454\uD574\uC9D1\uB2C8\uB2E4."
    desc: "\uC601\uAD6C DEF +2, \uCD5C\uB300 HP - 4"
    effects: 060000000700000007000000
