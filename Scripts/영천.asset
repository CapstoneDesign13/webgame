  m_Name: "\uC601\uCC9C"
  m_EditorClassIdentifier: Assembly-CSharp::PubDialogSO
  type: 3
  title_txt: "\uC218\uBB35\uD654 \uD48D\uC758 \uC740\uC740\uD55C \uB3D9\uAD74 \uC18D,
    \uC2E0\uBE44\uB86D\uAC8C \uD478\uB978\uBE5B\uC744 \uB0B4\uBFDC\uC73C\uBA70 \uC19F\uC544\uB098\uB294
    \uC0D8\uBB3C."
  content_txt: "\uD480\uC232 \uC0AC\uC774 \uC228\uACA8\uC9C4 \uB3D9\uAD74\uC5D0\uC11C
    \uC601\uD5D8\uD55C \uAE30\uC6B4\uC774 \uC11C\uB9B0 \uC0D8\uBB3C\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4.
    \uB9D1\uC740 \uBB3C\uC904\uAE30\uC5D0\uC11C \uB530\uC2A4\uD55C \uB0B4\uACF5\uC758
    \uD750\uB984\uC774 \uB290\uAEF4\uC9D1\uB2C8\uB2E4."
  entries:
  - content: "\uC0D8\uBB3C\uC744 \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uD55C \uBAA8\uAE08
      \uB9C8\uC2E0\uB2E4."
    desc: "\uCCB4\uB825 50% \uD68C\uBCF5"
    effects: 03000000
  - content: "\uC601\uCC9C\uC758 \uC6D0\uB958\uB97C \uD30C\uD5E4\uCCD0 \uAE30\uC6B4\uC744
      \uD1B5\uC9F8\uB85C \uD761\uC218\uD55C\uB2E4."
    desc: "[50% \uD655\uB960] \uCCB4\uB825 100% \uD68C\uBCF5 / [50% \uD655\uB960]
      \uCCB4\uB825 - 2"
    effects: 04000000
